{
  "name": "@equitech-dev/ui-library",
  "version": "2.0.0",
  "description": "Librairie de composants UI génériques pour Equitech",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./Button": {
      "types": "./dist/Button/index.d.ts",
      "import": "./dist/Button/index.js",
      "default": "./dist/Button/index.js"
    },
    "./Badge": {
      "types": "./dist/Badge/index.d.ts",
      "import": "./dist/Badge/index.js",
      "default": "./dist/Badge/index.js"
    },
    "./Card": {
      "types": "./dist/Card/index.d.ts",
      "import": "./dist/Card/index.js",
      "default": "./dist/Card/index.js"
    },
    "./Alert": {
      "types": "./dist/Alert/index.d.ts",
      "import": "./dist/Alert/index.js",
      "default": "./dist/Alert/index.js"
    },
    "./Input": {
      "types": "./dist/Input/index.d.ts",
      "import": "./dist/Input/index.js",
      "default": "./dist/Input/index.js"
    },
    "./Textarea": {
      "types": "./dist/Textarea/index.d.ts",
      "import": "./dist/Textarea/index.js",
      "default": "./dist/Textarea/index.js"
    },
    "./Checkbox": {
      "types": "./dist/Checkbox/index.d.ts",
      "import": "./dist/Checkbox/index.js",
      "default": "./dist/Checkbox/index.js"
    },
    "./RadioButton": {
      "types": "./dist/RadioButton/index.d.ts",
      "import": "./dist/RadioButton/index.js",
      "default": "./dist/RadioButton/index.js"
    },
    "./Switch": {
      "types": "./dist/Switch/index.d.ts",
      "import": "./dist/Switch/index.js",
      "default": "./dist/Switch/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:js": "tsup && node scripts/add-use-client.mjs",
    "build:css": "sass index.scss:dist/index.css --style=compressed",
    "build": "npm run build:js && npm run build:css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "keywords": [
    "ui",
    "components",
    "react",
    "scss",
    "design-system"
  ],
  "author": "Equitech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equitech-dev/ui-librairy.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sass": "^1.90.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  }
}
